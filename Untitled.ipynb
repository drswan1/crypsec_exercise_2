   "source": [
    "A = AlphabeticStrings()\n",
    "S = ShiftCryptosystem(A)\n",
    "\n",
    "# Load the ciphertext\n",
    "ciphertext = A(\"OIHCAOHWCBQOBUFSOHZMVSZDWBQFMDHOBOZWGWG\")\n",
    "\n",
    "# Brute-force all 26 possible shift keys\n",
    "for key in range(26):\n",
    "    plaintext = S.deciphering(key, ciphertext)\n",
    "    print(f\"Key {key:2d}: {plaintext}\")"
   ]
